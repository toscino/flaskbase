# Copy to .env in this directory (example_llm/) before running locally.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FLASK_SECRET=generate-a-long-random-secret
ADMIN_KEY=your-admin-access-key

# Required: unique prefix per app to avoid env var collisions across projects
FLASK_BASE_KEY_PREFIX=LLM_EXAMPLE_KEY_

# User keys: LLM_EXAMPLE_KEY_<NAME>=secret:permission1,permission2
LLM_EXAMPLE_KEY_ALICE=alice-secret:view

# Optional LLM settings (defaults shown)
LLM_LOCATION=global
LLM_MODEL=gemini-3.1-flash-lite

# Optional local port (default 8080)
# PORT=8080
