# Copy to .env in this directory (example/) before running locally.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FLASK_SECRET=generate-a-long-random-secret
ADMIN_KEY=your-admin-access-key

# Required: unique prefix per app to avoid env var collisions across projects
FLASK_BASE_KEY_PREFIX=EXAMPLE_KEY_

# User keys: EXAMPLE_KEY_<NAME>=secret:permission1,permission2
# Pass secret as ?key= in the URL; display name comes from the env var name (Alice, Bob).
EXAMPLE_KEY_ALICE=alice-secret:view
EXAMPLE_KEY_BOB=bob-secret:view

# Optional local port (default 8080)
# PORT=8080
